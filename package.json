{
  "name": "editable-website-demo",
  "version": "0.1.0",
  "private": true,
  "description": "Next.js demo for editable-website. Sign in, click the pencil, and edit page copy. The editor is the editable-website npm package.",
  "license": "MIT",
  "author": "Adam Siwiec",
  "repository": {
    "type": "git",
    "url": "https://github.com/adamsiwiec1/editable-website.git"
  },
  "keywords": [
    "nextjs",
    "react",
    "typescript",
    "tailwindcss",
    "cms",
    "headless-cms",
    "inline-editing",
    "visual-editor",
    "contenteditable",
    "marketing-website",
    "landing-page",
    "starter-template",
    "nextjs-starter",
    "editable-website"
  ],
  "workspaces": [
    "packages/core",
    "packages/cli"
  ],
  "scripts": {
    "predev": "npm run build -w editable-website",
    "dev": "next dev --port 3010",
    "prebuild": "npm run build -w editable-website",
    "build": "next build",
    "start": "next start --port 3010",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test lib/feature-demo-storage.test.ts lib/inventory.test.ts lib/demo-place.test.ts packages/core/src/copy.test.ts packages/cli/detect.test.mjs",
    "demo:html": "npm run dev --prefix demos/vanilla",
    "demo:vanilla": "npm run dev --prefix demos/vanilla",
    "demo:react": "npm run dev --prefix demos/react",
    "demo:svelte": "npm run dev --prefix demos/svelte",
    "demo:next": "npm run dev --prefix demos/next",
    "example:api": "npm start --prefix examples/express",
    "cli": "node packages/cli/bin.mjs",
    "deploy:demo:html": "npm run deploy --prefix demos/vanilla",
    "deploy:demo:react": "npm run deploy --prefix demos/react",
    "deploy:demo:svelte": "npm run deploy --prefix demos/svelte",
    "deploy:demo:next": "npm run deploy --prefix demos/next"
  },
  "dependencies": {
    "editable-website": "workspace:*",
    "gsap": "^3.15.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
